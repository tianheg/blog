{
  "name": "blog",
  "private": true,
  "scripts": {
    "build": "hugo --gc --minify --buildFuture --cleanDestinationDir",
    "pagefind": "pagefind --site public",
    "dev": "hugo serve --buildFuture",
    "all": "npm run check-unicode && npm run check-links && node scripts/check.mjs photos && npm run build && npm run pagefind",
    "check-links": "node scripts/check.mjs links",
    "check-external-links": "node scripts/check.mjs external",
    "check-unicode": "node scripts/check.mjs unicode",
    "test-unicode": "node scripts/check.mjs unicode-selftest",
    "related": "python3 scripts/generate-related.py",
    "embed": "node scripts/generate-embeddings.mjs && python3 scripts/generate-related.py"
  },
  "devDependencies": {
    "@tailwindcss/cli": "^4.3.0",
    "@tailwindcss/typography": "^0.5.19",
    "pagefind": "^1.5.2",
    "tailwindcss": "^4.3.0"
  },
  "dependencies": {
    "vis-network": "^10.0.3"
  }
}
