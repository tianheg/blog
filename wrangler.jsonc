{
  "name": "blog",
  "compatibility_date": "2025-06-08",
  "main": "./scripts/worker.js",
  "build": {
    "command": "ORG2SITE_STRICT=1 bash scripts/org2site/build.sh public"
  },
  "assets": {
    "directory": "./public",
    "not_found_handling": "404-page",
    "binding": "ASSETS",
    // /photos/* 资产目录里没有（走 R2 binding），显式 Worker 优先，
    // 不依赖「非 navigate 请求才轮到 Worker」的隐式路由。其余保持 assets-first。
    // /photos/* 与 /api/*（语义搜索）由 Worker 先接管：assets-first + not_found_handling=404-page
    // 会让「资产目录里不存在的 GET」直接吃 404，Worker 路由永远轮不到。
    // /projects/music/* 同理 —— 律谱是 SPA，/projects/music/4 这类深链接要回落 index.html，
    // 不放进 worker-first 的话 worker.js 里的 SPA fallback 是死代码（刷新曲目页 404）。
    "run_worker_first": ["/photos/*", "/api/*", "/projects/music/*"]
  },
  "r2_buckets": [
    {
      "binding": "IMG_R2",
      "bucket_name": "img"
    }
  ],
  "ai": {
    "binding": "AI"
  }
}
